# 1ai-osint Environment Configuration
# Copy this file to .env and fill in your API keys.

# === OmniRoute AI Gateway ===
# Base URL for OmniRoute OpenAI-compatible endpoint
OMNIRoute_BASE_URL=http://localhost:3000/v1
# API key for OmniRoute (if required)
OMNIRoute_API_KEY=

# === OpenAI (direct, fallback) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# === Breach / Leak Data Sources ===
# Have I Been Pwned
HIBP_API_KEY=
# Shodan
SHODAN_API_KEY=
# Censys
CENSYS_API_KEY=
# VirusTotal
VIRUSTOTAL_API_KEY=
# AbuseIPDB
ABUSEIPDB_API_KEY=
# WhoisXML
WHOISXML_API_KEY=
# Chiasmodon
CHIASMODON_TOKEN=
# DeHashed
DEHASHED_API_KEY=
# Scylla
SCYLLA_API_KEY=
# LeakCheck
LEAKCHECK_API_KEY=
# BreachDirectory
BREACHDIRECTORY_API_KEY=
# Snusbase
SNUSBASE_API_KEY=
# IntelX
INTELX_API_KEY=

# === GitHub ===
# For gitleaks / GitHub dork scanning
GITHUB_TOKEN=

# === Twitter ===
# For Twitter leak scanning (via twitter-cli: uv tool install twitter-cli)
# Get from browser cookies on x.com (auth_token and ct0 values)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# === ZKIT ===
# Per-investigation salt for ZKIT identity hashing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ZKIT_SALT=

# === Telegram Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Webhook Alerts ===
WEBHOOK_URL=

# === OSINT tooling (bundled via pip) ===
# sherlock-project is a core dependency (people_finder / username enumeration)
# Optional: pip install maigret  # broader site coverage, slower

# === Application Settings ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Cache directory (relative to project root)
CACHE_DIR=.osint_cache
# Rate limit file
RATE_LIMIT_FILE=.osint_rate_limit.json
# Compliance audit log (blueprint Layer 3) — every adapter query is recorded here
AUDIT_LOG_PATH=.osint_audit.jsonl
# Job persistence dir for the API server; empty = <project_root>/state/jobs
API_JOBS_DIR=
# Comma-separated CORS origins for the API server; empty = dev defaults (localhost:5173)
# The API app also honors AI_OSINT_JOBS_DIR / AI_OSINT_CORS_ORIGINS as direct overrides.
API_CORS_ORIGINS=

# === Database ===
# Backend: sqlite or postgres
DB_TYPE=sqlite
# SQLite path (used when DB_TYPE=sqlite)
DB_PATH=1ai-osint.db
# Postgres connection (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osint
DB_USER=osint
DB_PASSWORD=

# === Web UI ===
# Optional bearer token protecting the web dashboard (src/web).
# When set, every route except /api/health, /static, and /api/auth/login requires:
#   Authorization: Bearer <WEB_AUTH_TOKEN>
# When empty/unset, the web UI runs unauthenticated (local dev default).
WEB_AUTH_TOKEN=
# Multi-tier bearer tokens: tier:token,tier:token (e.g. readonly:tok1,admin:tok2).
# Overrides legacy WEB_AUTH_TOKEN for per-tier RBAC (tiers: readonly, analyst, admin).
WEB_AUTH_TOKENS=

# === Master Node API (distributed coordination) ===
# Bearer token for the master coordination API (src/modules/node/master_api.py).
# WARNING: when unset, the node API stays open (backward-compatible local dev
# default). Set a strong token for any shared/distributed deployment.
MASTER_API_TOKEN=
