# Copy to .env and adjust for your environment.
# API base URL of the 1ai-osint backend service (see src/api/app.py).
# Leave unset in dev: requests go same-origin to /api and the Vite dev server
# proxies them to http://127.0.0.1:8000 (see vite.config.ts).
# Set this to talk to a different backend (production build / remote host).
# VITE_API_BASE_URL=http://127.0.0.1:8000
