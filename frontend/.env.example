# Copy to .env and adjust for your environment.
# API base URL of the 1ai-osint backend service (see src/api/app.py).
# The Vite dev server proxies nothing by default, so this must point at the
# running FastAPI service. Leave unset to use http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000
