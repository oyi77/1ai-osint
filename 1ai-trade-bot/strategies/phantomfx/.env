# ═══════════════════════════════════════════════
# PhantomFX v4.0 — Environment Configuration
# ═══════════════════════════════════════════════
#
# 📍 Lokasi: strategies/phantomfx/.env
# 📋 Copy dari .env.example dan isi sesuai

# ─── Wajib ───────────────────────────────────
# Telegram bot untuk sinyal & alert
PHANTOMFX_TELEGRAM_BOT_TOKEN=***
PHANTOMFX_TELEGRAM_CHAT_ID=-1002928711742

# ─── Path A: Direct MT5 EA (REKOMENDASI) ─────
# PhantomFX EA listens on MT5 at port 8765
MT5_EA_WEBHOOK_URL=http://localhost:8765
MT5_EA_WEBHOOK_TOKEN=***

# ─── Path B: MT5 Router (optional — multi-instance) ──
# Biarkan kosong kalau pakai Path A
MT5_ROUTER_URL=
MT5_ROUTER_API_KEY=
***_INSTANCE_ID=
