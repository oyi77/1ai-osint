<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Intel Report — {{ report.target }}</title>
<style>
body { background-color: #f2f2f2; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.content { display: flex; flex-wrap: wrap; }
.block { width: 45%; margin: 1%; border-radius: 10px; padding: 14px; background-color: white; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.left { width: 80%; margin-left: 20%; padding-bottom: 40px; }
.nav { background-color: #1e293b; position: fixed; left: 0; top: 0; width: 18%; min-width: 200px; height: 100%; overflow: auto; }
.nav a { color: #e2e8f0; display: block; padding: 10px 12px; text-decoration: none; font-size: 13px; border-bottom: 1px solid #334155; }
.nav a:hover { background-color: #334155; color: white; }
.nav-title { color: white; font-size: 18px; font-weight: bold; padding: 14px 12px; border-bottom: 2px solid #4CAF50; }
.hero { background: linear-gradient(135deg, #1e3a5f, #0f172a); color: white; padding: 20px 24px; margin: 0 1% 16px; border-radius: 10px; width: 98%; }
.hero h1 { margin: 0 0 8px; font-size: 26px; }
.hero .meta { font-size: 13px; opacity: 0.9; line-height: 1.6; }
.stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.stat { background: rgba(255,255,255,.12); padding: 8px 14px; border-radius: 8px; font-size: 12px; }
.stat b { font-size: 18px; display: block; }
.title { font-size: 22px; font-weight: bold; margin: 16px 1% 8px; color: #1e293b; }
.block-title { font-size: 17px; font-weight: bold; margin-bottom: 8px; color: #0f172a; }
.block-text { font-size: 14px; line-height: 1.55em; color: #334155; }
.block-text code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 13px; word-break: break-all; }
.block-text a { color: #2563eb; }
.block-desc { font-size: 13px; color: #64748b; margin-bottom: 12px; font-style: italic; }
.record-sep { border-top: 1px dashed #e2e8f0; margin: 12px 0; padding-top: 12px; }
.warning { background: #fef3c7; color: #92400e; padding: 8px 12px; margin: 8px 1%; border-radius: 6px; font-size: 13px; width: 96%; }
.dashboard { width: 98%; margin: 0 1% 20px; background: white; border-radius: 10px; padding: 16px; }
.dashboard h2 { font-size: 16px; margin: 0 0 10px; color: #1e293b; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #f1f5f9; }
th { color: #64748b; font-size: 11px; text-transform: uppercase; }
.graph-wrap { text-align: center; overflow-x: auto; }
@media print {
  .nav { display: none; }
  .left { width: 100%; margin-left: 0; }
  .block { width: 100%; page-break-inside: avoid; }
}
</style>
</head>
<body>

<div class="nav">
  <div class="nav-title">Intel Report</div>
  <a href="#overview"><b>📊 Overview</b></a>
  <a href="#evidence"><b>📋 Evidence Table</b></a>
  <a href="#graph"><b>🕸 Identity Graph</b></a>
  <a href="#sources"><b>📁 Sources</b></a>
  {% for block in report.source_blocks %}
  <a href="#{{ block.block_id }}"><b>{{ block.title }}</b></a>
  {% endfor %}
</div>

<div class="left">

<div id="overview" class="hero">
  <h1>{{ report.target }}</h1>
  <div class="meta">
    Report <code>{{ report.report_id }}</code> ·
    {{ "%.1f"|format(report.duration_sec) }}s ·
    {{ report.iterations }} iteration(s) ·
    Risk: <strong>{{ report.risk.level.value|upper }}</strong> ({{ "%.0f"|format(report.risk.score * 100) }}%)
  </div>
  <div class="stats">
    <div class="stat"><b>{{ report.evidence|length }}</b>Evidence</div>
    <div class="stat"><b>{{ report.source_blocks|length }}</b>Sources</div>
    <div class="stat"><b>{{ report.modules_run|length }}</b>Modules</div>
    <div class="stat"><b>{{ report.pivots|length }}</b>Pivots</div>
    <div class="stat"><b>{{ confidence_by_identifier|length }}</b>Identifiers</div>
  </div>
  <p style="margin-top:14px;font-size:14px;line-height:1.5">{{ report.summary }}</p>
</div>

{% if report.warnings %}
{% for w in report.warnings %}
<div class="warning">⚠️ {{ w }}</div>
{% endfor %}
{% endif %}

<div id="evidence" class="dashboard">
  <h2>Evidence index ({{ report.evidence|length }})</h2>
  <table>
    <tr><th>Value</th><th>Type</th><th>Source</th><th>Rel.</th><th>Confidence</th><th>Link</th></tr>
    {% for ev in report.evidence %}
    <tr>
      <td><code>{{ ev.identifier_value[:60] }}</code></td>
      <td>{{ ev.identifier_type }}</td>
      <td>{{ ev.source }}</td>
      <td>{{ ev.source_reliability }}</td>
      <td>{{ "%.0f"|format(ev.confidence * 100) }}%</td>
      <td>{% if ev.url %}<a href="{{ ev.url }}" target="_blank">open</a>{% else %}—{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
</div>

<div id="graph" class="dashboard graph-wrap">
  <h2>Identity graph</h2>
  {{ svg_graph }}
</div>

<div id="sources" class="title">Source intelligence blocks</div>
<div class="content">
{% for block in report.source_blocks %}
<div id="{{ block.block_id }}" class="block">
  <div class="block-title"><b>{{ block.title }}</b> <small>({{ block.records|length }} record{{ "s" if block.records|length != 1 else "" }})</small></div>
  <div class="block-desc">{{ block.description }}</div>
  <div class="block-text">
    {% for record in block.records %}
    {% if not loop.first %}<div class="record-sep"></div>{% endif %}
    {{ format_record(record) }}
    {% endfor %}
  </div>
</div>
{% else %}
<div class="block" style="width:96%"><div class="block-text"><i>No source blocks — run additional modules or check API keys.</i></div></div>
{% endfor %}
</div>

{% if report.pivots %}
<div class="dashboard">
  <h2>Recommended pivots</h2>
  <table>
    <tr><th>Type</th><th>Value</th><th>Rationale</th><th>Sources</th></tr>
    {% for p in report.pivots %}
    <tr>
      <td>{{ p.target_type }}</td>
      <td><code>{{ p.target_value }}</code></td>
      <td>{{ p.rationale }}</td>
      <td>{{ p.expected_sources|join(", ") }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

<p style="color:#94a3b8;font-size:12px;text-align:center;margin:24px">
  Generated by 1ai-osint · {{ report.completed_at }}
</p>

</div>
</body>
</html>
